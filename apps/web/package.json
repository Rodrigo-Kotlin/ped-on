    "workbox-window": "7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pedon/config": "workspace:*",
    "@pedon/test-utils": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
