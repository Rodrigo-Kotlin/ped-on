# =============================================================
# PED-ON — Variáveis de ambiente (EXEMPLO)
# =============================================================
# Este arquivo contém SOMENTE nomes de variáveis.
# NUNCA coloque valores reais aqui e nunca commite arquivos .env.
# Copie para .env e preencha localmente/CI.

# -------------------------------------------------------------
# Público (frontend — prefixo VITE_*)
# Nenhuma variável sensível pode ser exposta com prefixo público.
# NUNCA declare service_role com prefixo VITE_*.
# -------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -------------------------------------------------------------
# Servidor / CI (sem prefixo público — NUNCA expor no frontend)
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
